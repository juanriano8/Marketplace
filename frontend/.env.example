# ============================================================================
# Variables del panel (Next.js)
# ----------------------------------------------------------------------------
# En local copia este archivo como `.env.local`.
# En Vercel se configuran en Project → Settings → Environment Variables.
# ============================================================================

# URL pública del backend Spring Boot en Render.
# En local: http://localhost:8080
MARKETPLACE_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Neon Object Storage (solo lo usa el route handler /api/upload en el servidor)
# ---------------------------------------------------------------------------
# Se obtienen al crear un bucket `public_read` en Neon Console → Object storage.
# En local se puede omitir: la subida cae al disco de `public/images/productos`.
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=marketplace-images
