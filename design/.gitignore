# Datos crudos descargados de la API de Figma (varios MB, se regeneran con
# `node figma-extract.mjs <file-key>`). No hace falta versionarlos.
figma-data/

# Capturas y miniaturas temporales
*.webp

# Cache local de npm para los CLI (npx) y respuestas crudas de las APIs
.npm-cache/
*.json

# Se conservan: stitch-design-md.md, stitch-catalogo-real.html y el .png de referencia
!package.json