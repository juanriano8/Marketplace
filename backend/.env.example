# ============================================================================
# Plantilla de variables de entorno
# ----------------------------------------------------------------------------
# 1. Copia este archivo como:  backend/.env
# 2. Rellena los valores con los datos reales de tu instancia Cloud SQL.
# 3. No subas .env al repositorio (ya está en .gitignore).
# ============================================================================

# ---- Google Cloud SQL (PostgreSQL) ----
# Host de la instancia. Opciones, de más simple a más segura:
#   * IP PÚBLICA de la instancia   ->  35.193.xx.xx     (requiere autorizar tu IP en Cloud SQL)
#   * IP PRIVADA (misma VPC)       ->  10.xx.xx.xx      (requiere VPC Connector en Cloud Run)
#   * 127.0.0.1                    ->  si usas Cloud SQL Auth Proxy en local (recomendado)
DB_HOST=34.xxx.xxx.xxx
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=marketplace_app
DB_PASSWORD=cambia-esta-password

# sslmode: require (por defecto) | verify-ca | verify-full | disable (sólo pruebas locales)
DB_SSLMODE=require

# ---- Conexión ----
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# ---- JPA ----
# update = crea el esquema automáticamente (ideal para la demo)
# validate = no toca el esquema (producción con migraciones)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- JWT ----
# En producción este valor debe venir de GCP Secret Manager, no del repositorio.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ---- Pasarela de pago simulada ----
# true  = el pago se captura y la orden queda PAID
# false = el pago queda PENDING (sirve para probar la rama de fallo)
PAYMENT_STUB_CAPTURE=true

# ---- Perfil de Spring activo ----
SPRING_PROFILES_ACTIVE=cloud
SERVER_PORT=8080

# ---- Administrador inicial (obligatorio para probar /api/v1/admin/**) ----
# No existe endpoint público de registro de administradores: si defines estas dos
# variables, la aplicación crea el administrador en el primer arranque y luego
# puedes dejarlas vacías (o cambiar la contraseña).
BOOTSTRAP_ADMIN_EMAIL=admin@marketplace.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
