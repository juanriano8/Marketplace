# ---- Google Cloud SQL (PostgreSQL) ----
# Valores de la instancia de este proyecto (marketplace-509503:us-central1:marketplace):
DB_HOST=136.112.91.42
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASSWORD=cambia-esta-password

# Si algÃºn dÃ­a usas otra instancia, las opciones de host son:
#   * IP PÃšBLICA de la instancia   ->  35.193.xx.xx     (requiere autorizar tu IP en Cloud SQL)
#   * IP PRIVADA (misma VPC)       ->  10.xx.xx.xx      (requiere VPC Connector en Cloud Run)
#   * 127.0.0.1                    ->  si usas Cloud SQL Auth Proxy en local (recomendado en producciÃ³n)

# sslmode: require (por defecto) | verify-ca | verify-full | disable (sÃ³lo pruebas locales)
DB_SSLMODE=require

# ---- ConexiÃ³n ----
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# ---- JPA ----
# update = crea el esquema automÃ¡ticamente (ideal para la demo)
# validate = no toca el esquema (producciÃ³n con migraciones)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- JWT ----
# En producciÃ³n este valor debe venir de GCP Secret Manager, no del repositorio.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ---- Pasarela de pago simulada ----
# true  = el pago se captura y la orden queda PAID
# false = el pago queda PENDING (sirve para probar la rama de fallo)
PAYMENT_STUB_CAPTURE=true

# ---- Perfil de Spring activo ----
SPRING_PROFILES_ACTIVE=cloud

# ---- Administrador inicial ----
# No existe endpoint pÃºblico de registro de administradores.
#
# IMPORTANTE: el administrador se crea UNA SOLA VEZ, en el primer arranque.
# Como la base de datos es COMPARTIDA, si ya lo creaste desde otro PC este
# bloque no hace nada y debes usar la contraseÃ±a que pusiste entonces.
# Si cambias la contraseÃ±a aquÃ­ despuÃ©s, el login fallarÃ¡ con 401: para
# aplicarla usa backend/tools/AdminPasswordSync.java (ver guÃ­a, apartado 10.3.1).
BOOTSTRAP_ADMIN_EMAIL=admin@marketplace.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
