# ============================================================================
# Plantilla de variables de entorno
# ----------------------------------------------------------------------------
# NO edites este archivo: cópialo.
#
#   Windows :  powershell -ExecutionPolicy Bypass -File .\setup.ps1
#   Linux   :  cp .env.example .env  &&  nano .env
#
# El .env NO se sube al repositorio (está en .gitignore) porque contiene
# credenciales: es lo que hay que recrear en cada PC nuevo.
# ============================================================================

# ---- Base de datos: Neon (PostgreSQL en la nube, plan gratuito) ----
# El proyecto usa Neon desde 2026-11-08 (antes usaba Google Cloud SQL, cuyo
# periodo de prueba terminó).
#
# Los datos de conexión se obtienen en https://console.neon.tech:
#   Project -> Connect -> cadena de conexión DIRECTA (sin "-pooler").
#
# La cadena tiene esta forma:
#   postgresql://neondb_owner:CONTRASENA@ep-xxxx-123456.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require
#   └──────┬──────┘ └────┬───┘ └──────────────┬────────────────────────────┘ └──┬──┘
#        usuario     password              host                            base de datos
#
# ¿Por qué la conexión DIRECTA y no la "pooled"? Flyway crea el esquema al
# arrancar y el pooler complica las sentencias DDL. La app, con el pool de
# Hikari por debajo, no necesita el pooler de Neon.
DB_HOST=ep-xxxx-123456.c-16.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=cambia-esta-password

# Neon exige TLS. No lo pongas en "disable".
DB_SSLMODE=require

# ---- Conexión ----
# Neon (plan gratuito) limita las conexiones: mantén el pool pequeño.
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

# ---- JPA / Flyway ----
# El esquema lo gobierna FLYWAY (backend/src/main/resources/db/migration).
# "validate" hace que Hibernate solo compruebe que el esquema coincide.
# NO uses "update" aquí: pisaría las migraciones y el control de cambios.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ---- JWT ----
# Obligatorio. Sin esta variable la aplicación falla al arrancar (fail-fast).
# Genera una con:  openssl rand -hex 32
# En producción debe venir de GCP Secret Manager, no del repositorio.
JWT_SECRET=<TU_JWT_SECRET>
JWT_EXPIRATION_MS=86400000

# ---- Pasarela de pago simulada ----
# true  = el pago se captura y la orden queda PAID
# false = el pago queda PENDING (sirve para probar la rama de fallo)
PAYMENT_STUB_CAPTURE=true

# ---- Perfil de Spring activo ----
# "cloud" solo cambia el pool y el SSL; sirve igual para Neon.
SPRING_PROFILES_ACTIVE=cloud

# ---- Control de tasa (Bucket4j) ----
# Valores por minuto. Los de por defecto son generosos a propósito.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON=60
RATE_LIMIT_USER=600
RATE_LIMIT_AUTH=30

# ---- Caché de catálogo (Caffeine) ----
CACHE_CATALOG_TTL_SECONDS=30
CACHE_DETAIL_TTL_SECONDS=60
CACHE_MAX_ENTRIES=1000

# ---- Write-behind del rating de vendedor ----
SELLER_RATING_FLUSH_MS=5000

# ---- Administrador inicial ----
# No existe endpoint público de registro de administradores.
#
# IMPORTANTE: el administrador se crea UNA SOLA VEZ, en el primer arranque.
# Como la base de datos es COMPARTIDA, si ya lo creaste desde otro PC este
# bloque no hace nada y debes usar la contraseña que pusiste entonces.
# Si cambias la contraseña aquí después, el login fallará con 401: para
# aplicarla usa backend/tools/AdminPasswordSync.java.
BOOTSTRAP_ADMIN_EMAIL=admin@marketplace.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
